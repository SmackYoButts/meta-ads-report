# Meta Ads API
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_ad_account_id_here   # e.g. 123456789 or act_123456789

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here   # e.g. 123456789:ABCDEFabcdef
TELEGRAM_CHAT_ID=your_telegram_chat_id_here       # e.g. -1001234567890 for groups

# Google Sheets
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit
GOOGLE_CREDENTIALS_JSON_PATH=credentials.json     # path to your service account JSON file
